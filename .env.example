# Copy to `.dev.vars` for local `wrangler dev`. Vite/Node tests that read
# process.env can also use `.env.local`. On Cloudflare, set the same names
# as Worker vars/secrets (dashboard or `wrangler secret put`).

# Celo mainnet RPC (recommended: dedicated provider in production)
# CELO_RPC_URL_MAINNET=https://forno.celo.org

# Ethereum RPC for ENS resolution (optional)
# ETH_RPC_URL_MAINNET=https://ethereum.publicnode.com

# Public base URL used on the A2A agent card (optional)
# CELINA_A2A_BASE_URL=https://mcp.usecelina.xyz

# Do NOT set CELO_PRIVATE_KEY or SELF_AGENT_PRIVATE_KEY on the hosted read-only endpoint.
