{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "celina-mcp-remote",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/mcp", "/a2a", "/health"]
  }
}
